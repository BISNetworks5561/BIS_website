# Supabase (프로젝트: gptxhbyzmsmqpyjnuqho / BISNetworks 조직 / BIS_website)
NEXT_PUBLIC_SUPABASE_URL=https://gptxhbyzmsmqpyjnuqho.supabase.co

# 공개 키 (publishable / anon). RLS 정책으로 상담신청 INSERT 만 가능.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (선택) 서버 전용 비밀 키. 있으면 이 키를 우선 사용. 절대 클라이언트/저장소에 노출 금지.
# Supabase 대시보드 > Project Settings > API Keys
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# 배포 도메인 (OG 태그, sitemap 용)
NEXT_PUBLIC_SITE_URL=https://www.bisnetworks.co.kr

# ── 백오피스 (/admin) ──
# 접근 키. 아무 문자열이나 정해서 넣고, 백오피스 로그인 화면에 같은 값을 입력.
ADMIN_PASSCODE=
# Claude API 키 (console.anthropic.com → API Keys). 서버 전용, 절대 노출 금지.
ANTHROPIC_API_KEY=
