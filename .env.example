# Supabase (프로젝트: gptxhbyzmsmqpyjnuqho / BISNetworks 조직 / BIS_website)
NEXT_PUBLIC_SUPABASE_URL=https://gptxhbyzmsmqpyjnuqho.supabase.co

# 공개 키 (publishable / anon). RLS 정책으로 상담신청 INSERT 만 가능.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (선택) 서버 전용 비밀 키. 있으면 이 키를 우선 사용. 절대 클라이언트/저장소에 노출 금지.
# Supabase 대시보드 > Project Settings > API Keys
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# 배포 도메인 (OG 태그, sitemap 용)
NEXT_PUBLIC_SITE_URL=https://www.bisnetworks.co.kr

# ── 백오피스 (/admin) ──
# 접근 키. 아무 문자열이나 정해서 넣고, 백오피스 로그인 화면에 같은 값을 입력.
ADMIN_PASSCODE=
# Claude API 키 (console.anthropic.com → API Keys). 서버 전용, 절대 노출 금지.
ANTHROPIC_API_KEY=

# ── (선택) 글 생성 엔진 추가 ──
# Google Gemini: https://aistudio.google.com/apikey 에서 발급. 모델 기본값 gemini-2.5-flash
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro
# Ollama: 로컬 PC는 http://localhost:11434 (개발 서버에서만 동작). Vercel 배포본에서 쓰려면
# 외부에서 접근 가능한 주소(고정 IP/터널/클라우드)여야 하고, ollama.com 클라우드는 OLLAMA_API_KEY 만 설정.
OLLAMA_BASE_URL=
OLLAMA_MODEL=gemma3:12b
# OLLAMA_API_KEY=
